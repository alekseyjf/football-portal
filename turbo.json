{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
      "build": {
        "dependsOn": ["^build"],
        "outputs": [".next/**", "dist/**"]
      },
      "dev": {
        "dependsOn": ["^build"],
        "cache": false,
        "persistent": true
      },
      "lint": {
        "dependsOn": ["^lint"]
      },
      "typecheck": {
        "dependsOn": ["^build"],
        "cache": false
      },
      "test": {
        "dependsOn": ["^build"],
        "cache": false
      }
    }
  }
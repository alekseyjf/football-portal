# Змінні середовища web. Скопіюй у `.env.local` (у git не потрапляє); без файлу код бере ті самі
# значення, що нижче, — дефолти для локальної розробки.
# NEXT_PUBLIC_* вбудовуються в JS під час збірки й видні кожному відвідувачу — секретів тут бути не може.

# URL API з префіксом; на сервері збірки — публічний https-адрес API
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Ліга сайдбару головної без ?league= — Competition.slug (код змагання, напр. PL);
# немає або ліга неактивна — перша активна за sortOrder
NEXT_PUBLIC_DEFAULT_LEAGUE_SLUG=PL
# Адмінка — посилання в навбарі
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

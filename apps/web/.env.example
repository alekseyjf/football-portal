# Змінні середовища web. Скопіюй у `.env.local` (у git не потрапляє); без файлу код бере ті самі
# значення, що нижче, — дефолти для локальної розробки.
# NEXT_PUBLIC_* вбудовуються в JS під час збірки й видні кожному відвідувачу — секретів тут бути не може.
# Адреси API тут немає: браузер ходить на сам сайт (/api/v1/*), далі запит пересилає сервер сайту (API_ORIGIN нижче, D59).

# Ліга сайдбару головної без ?league= — Competition.slug (код змагання, напр. PL);
# немає або ліга неактивна — перша активна за sortOrder
NEXT_PUBLIC_DEFAULT_LEAGUE_SLUG=PL
# Адмінка — посилання в навбарі
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# ─── Серверні (читаються під час роботи сервера, не вбудовуються при збірці; перевірка — src/lib/env) ───
# Де працює сервер (D59): development — машина розробника (за замовчуванням у next dev; API — localhost, без секрету
# й пароля) | test — тест-сервер (пароль на всьому сайті) | production — прод. З NODE_ENV=production (next start,
# Vercel) обов'язкова; next start локально — development
APP_ENV=development
# API для сервера сайту — origin без шляху: SSR ходить сюди напряму, проксі /api/* пересилає сюди запити браузера.
# development без змінної — http://localhost:4000; поза ним обов'язкова й лише https (тест — https://….onrender.com)
API_ORIGIN=
# Секрет сервера сайту для API, ≥ 32 символи: той самий API_ORIGIN_SECRET, що в apps/api/.env. Без нього API
# поза development відповідає 403. Локально — порожньо (якщо в API його теж немає)
API_ORIGIN_SECRET=
# Спільні логін і пароль тест-сервера (Basic Auth, M1.11.6): лише з APP_ENV=test, і тоді обидва обов'язкові;
# пароль ≥ 12 символів. Ті самі — в адмінці
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Адреса самого сайту — origin без шляху: повні адреси в JSON-LD; посилання тексту новини на цей хост
# відкриваються в тій самій вкладці. У production (next start, тест-сервер) обов'язкова — без неї сервер
# не стартує; у next dev без неї — http://localhost:3000
SITE_URL=http://localhost:3000
# Індексація пошуковиками (M1.8.3): лише true відкриває сайт — robots.txt дозволяє, є sitemap-и. Без змінної
# (і з false) сайт закритий: robots.txt — Disallow: /, sitemap-и — 404, на сторінках X-Robots-Tag: noindex, nofollow.
# Тест-сервер — не задавати; прод — true
SITE_INDEXING=
# Вебхук API (D57): той самий REVALIDATE_SECRET, що в apps/api/.env (≥ 32 символи, openssl rand -base64 48).
# Ним маршрут POST /api/revalidate перевіряє підпис запиту (HMAC з часом); без змінної маршрут — 404, кеш сайту —
# за TTL (стрічка й головна — 5 хв, новина — година)
REVALIDATE_SECRET=
# Ротація секрету: новий — у REVALIDATE_SECRET тут, старий — сюди; потім новий в API; коли API перезапущено —
# цей рядок прибрати. Без REVALIDATE_SECRET не працює
REVALIDATE_SECRET_PREVIOUS=

# Змінні середовища API. Скопіюй у `.env` (у git не потрапляє) і заповни порожні обов'язкові.
# Схема — src/config/env.schema.ts: без обов'язкової або з невалідною змінною API не стартує
# й перелічує всі проблеми. `KEY=` без значення — те саме, що змінної немає (діє дефолт).
# Секрети — свої для кожного середовища (dev, тест, прод), між середовищами не переносимо.

# ── Середовище ──
# Обов'язково: development | production | test. production — secure-cookies, лише https у CORS_ORIGINS,
# обов'язковий TRUST_PROXY
NODE_ENV=development
# Де працює API (D59): development — машина розробника (за замовчуванням, поки NODE_ENV не production) | test —
# тест-сервер (Swagger — через сайт за паролем) | production — прод (без Swagger). З NODE_ENV=production обов'язкова
APP_ENV=development
# Порт HTTP; за замовчуванням 4000 (хостинг зазвичай задає свій)
PORT=4000

# ── База даних (Supabase → Connect) ──
# Локально — БД розробки; у тест-сервера своя, окремий проєкт Supabase (D61): її адреси — лише в панелі Render
# Обов'язково: рядок підключення застосунку — Transaction pooler, порт 6543
DATABASE_URL=
# Лише для CLI (prisma migrate, pnpm db:seed): Session pooler або Direct connection, порт 5432.
# Порожньо — CLI бере DATABASE_URL. API цю змінну не читає.
# Ще й джерело pnpm db:copy-to-test (копія БД розробки в тестову); адресу тестової скрипт питає сам, приховано, —
# сюди її не пиши
DIRECT_URL=
# Лише для e2e (pnpm --filter @football-portal/api test:e2e): БД, у якій тести створюють і перебудовують
# окрему схему `e2e` (`public` не чіпають). Session pooler / пряме з'єднання, не transaction pooler.
# Порожньо — e2e беруть DIRECT_URL; у CI — тимчасовий Postgres
E2E_DATABASE_URL=

# ── Секрети (згенерувати: openssl rand -base64 48) ──
# Обов'язково, ≥ 32 символи: підпис access-JWT (HS256). Зміна = усі access-токени недійсні (refresh живе)
JWT_SECRET=
# Обов'язково, ≥ 32 символи, ≠ JWT_SECRET: HMAC пошт видалених акаунтів (BlockedEmail).
# Після запуску НЕ змінювати — старі блоки перестануть збігатися
EMAIL_HASH_SECRET=

# ── HTTP ──
# Обов'язково: origin-и web і admin через кому — рівно scheme://host[:port], без шляху і «/» у кінці;
# на проді лише https. Це ж — дозволені Origin мутацій (CSRF, D60): POST / PUT / PATCH / DELETE з іншого — 403
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Скільки reverse proxy стоїть перед API (напр. 1) або їхні адреси / підмережі; 0 або false — проксі немає.
# У dev — порожньо; на проді обов'язково; true заборонено (клієнт підробить IP через X-Forwarded-For).
# Тест-сервер (Render) — false: X-Forwarded-For не довіряємо, IP браузера дає сервер сайту разом із API_ORIGIN_SECRET
TRUST_PROXY=
# Секрет серверів web і адмінки (D59), ≥ 32 символи, той самий — у їхньому API_ORIGIN_SECRET; ≠ решті секретів.
# З ним API приймає лише запити з цим секретом у заголовку x-origin-secret (крім /api/v1/health), інакше — 403.
# Локально — порожньо (API відкритий, як раніше); поза APP_ENV=development — обов'язковий
API_ORIGIN_SECRET=
# Лише на час ротації API_ORIGIN_SECRET — старе значення: API приймає обидва, поки web і адмінка не передеплоєні з новим.
# Порядок: Render — новий API_ORIGIN_SECRET + старий тут → Vercel (web і адмінка) — новий → Render — прибрати цю змінну
API_ORIGIN_SECRET_PREVIOUS=

# ── Football (football-data.org) ──
# true — повний синк активних турнірів кожні 2 год (тест, прод); за замовчуванням false: локально синк — кнопкою
# в адмінці, бо один ключ football-data на двох серверах ділив би ліміт 10 запитів / хв (D36)
FOOTBALL_SYNC_CRON_ENABLED=false
# API Token з кабінету https://www.football-data.org/client/register — НЕ id змагання і не код PL.
# Без нього синк відповідає 503 FOOTBALL_PROVIDER_NOT_CONFIGURED
FOOTBALL_API_KEY=
# Лише https (ключ іде в заголовку); за замовчуванням https://api.football-data.org/v4
FOOTBALL_API_URL=https://api.football-data.org/v4
# true — кожні 5 хв LIVE-синк турнірів, де зараз є матч; за замовчуванням false (лише on-demand)
FOOTBALL_LIVE_CRON_ENABLED=false
# true | false — логувати кожен запит до football-data; за замовчуванням true лише в development
FOOTBALL_HTTP_LOG=

# ── Анти-абуз ──
# Мінімальний інтервал між коментарями, мс; за замовчуванням 60000, 0 — вимкнути, максимум 86400000
COMMENT_COOLDOWN_MS=

# ── Сповіщення сайту (D57) ──
# Опційно, обидві або жодна: коли новина з'являється на сайті, змінюється чи зникає, API кличе вебхук web —
# кеш і sitemap сайту оновлюються одразу; без них — за TTL сайту. Локально — http://localhost:3000/api/revalidate;
# на проді — https або http до хоста приватної мережі (сервіс Docker: http://web:3000/api/revalidate)
WEB_REVALIDATE_URL=
# ≥ 32 символи (openssl rand -base64 48), той самий — у REVALIDATE_SECRET web; не JWT_SECRET / EMAIL_HASH_SECRET.
# У запиті не йде — лише підпис HMAC з часом
REVALIDATE_SECRET=

# ── Лише для pnpm db:seed: куди пише сід — обов'язково, без значення за замовчуванням ──
# public — dev-БД, e2e — схема тестів і стенду. До першого запису сід звіряє current_schema() з цим значенням
# і друкує ціль (prisma/schema-target.ts). Задавати в команді: SEED_TARGET_SCHEMA=public pnpm db:seed
# SEED_TARGET_SCHEMA=

# ── Лише для pnpm db:seed без prisma/seed-data/content.json (адмін для порожньої БД) ──
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Admin

# Змінні середовища адмінки. Скопіюй у `.env.local` (у git не потрапляє); без файлу код бере ті самі
# значення, що нижче, — дефолти для локальної розробки.
# NEXT_PUBLIC_* вбудовуються в JS під час збірки й видні кожному, хто відкрив адмінку, — секретів тут бути не може.

# Адреси API тут немає: браузер ходить на саму адмінку (/api/v1/*), далі запит пересилає її сервер (API_ORIGIN нижче, D59).

# Публічний сайт — посилання «на сайт» у шапці, на дашборді й у списку постів
NEXT_PUBLIC_PUBLIC_WEB_URL=http://localhost:3000

# ─── Серверні (читаються під час роботи сервера, не вбудовуються при збірці; перевірка — src/lib/env) ───
# Де працює сервер (D59): development — машина розробника (за замовчуванням у next dev; API — localhost, без секрету
# й пароля) | test — тест-сервер (пароль на всій адмінці) | production — прод. З NODE_ENV=production (next start,
# Vercel) обов'язкова; next start локально — development
APP_ENV=development
# API для сервера адмінки — origin без шляху: проксі /api/* пересилає сюди запити браузера. development без змінної —
# http://localhost:4000; поза ним обов'язкова й лише https (тест — https://….onrender.com)
API_ORIGIN=
# Секрет сервера адмінки для API, ≥ 32 символи: той самий API_ORIGIN_SECRET, що в apps/api/.env і web
API_ORIGIN_SECRET=
# Спільні логін і пароль тест-сервера (Basic Auth, M1.11.6): лише з APP_ENV=test, і тоді обидва обов'язкові;
# пароль ≥ 12 символів. Ті самі — у web
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
